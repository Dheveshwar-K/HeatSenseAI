# System Configuration
APP_NAME="EXTREME HEATWAVE EARLY WARNING & HUMAN THERMAL STRESS INDEX"
DEBUG=false
HOST=127.0.0.1
PORT=8000

# The Weather Company (TWC) API Configuration
WEATHER_COMPANY_API_KEY=
WEATHER_REQUEST_TIMEOUT=10
WEATHER_REFRESH_SECONDS=60
WEATHER_MAX_DATA_AGE_SECONDS=900
MOCK_WEATHER=false

# Emergency Thresholds
THERMAL_WATCH_THRESHOLD=40.0
THERMAL_WARNING_THRESHOLD=60.0
THERMAL_EXTREME_THRESHOLD=80.0
EMERGENCY_THRESHOLD=90.0
EMERGENCY_PERSISTENCE_SECONDS=60
EMERGENCY_COOLDOWN_SECONDS=600

# Emergency Contacts (Stored strictly backend-side)
EMERGENCY_CONTACT_1=+919876543210
EMERGENCY_CONTACT_1_NAME="Dr. A. Sharma (On-Duty Clinician)"
EMERGENCY_CONTACT_2=+919876543211
EMERGENCY_CONTACT_2_NAME="Emergency Response Team Dispatch"

# Telephony Configuration ('mock' for testing & simulation, 'twilio' for live outbound calls)
TELEPHONY_PROVIDER=mock
TELEPHONY_ACCOUNT_SID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_FROM_NUMBER=

# Safety switch: Automatic emergency phone calls disabled until explicitly verified
EMERGENCY_CALL_ENABLED=false
SIMULATION_MODE=true
MAX_CALL_RETRIES=2
